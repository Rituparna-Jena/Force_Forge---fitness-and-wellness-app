# FocusForge v2 server configuration
# Copy this file to .env and fill in your own key. The key stays on your
# machine: it is read only by the local server and is never sent to the
# extension or the dashboard.

# Groq API key (get one free at https://console.groq.com/keys)
GROQ_API_KEY=

# Model id. Read at runtime so a deprecated default never bricks the app.
# Current Groq default below; try llama-3.3-70b-versatile if you want a
# stronger (slower) judge.
FOCUSFORGE_MODEL=llama-3.1-8b-instant

# OpenAI-compatible base URL. Swap this to point at any compatible provider
# (OpenAI, Together, LM Studio, Ollama's /v1 shim, ...).
LLM_BASE_URL=https://api.groq.com/openai/v1

# Set to true to run the whole app with canned verdicts and no API key.
MOCK_LLM=false

# Server
PORT=3000

# Guardrails (all overridable)
DAILY_ALLOWANCE_MINUTES=30
ATTEMPT_BUDGET_PER_HOUR=8
